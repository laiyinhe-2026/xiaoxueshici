# 服务端口
PORT=3000

# 讯飞语音评测 ISE 流式版
# 文档：https://www.xfyun.cn/doc/Ise/IseAPI.html
XFYUN_APPID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_ISE_ENDPOINT=wss://ise-api.xfyun.cn/v2/open-ise

# PPIO 派欧云：Qwen-Image 图像编辑、Minimax Hailuo 2.3 文生视频、异步任务查询、DeepSeek 问答与评价整理
PPIO_API_KEY=
PPIO_IMAGE_ENDPOINT=https://api.ppio.com/v3/async/qwen-image-edit
PPIO_VIDEO_ENDPOINT=https://api.ppio.com/v3/async/minimax-hailuo-2.3-t2v
PPIO_TASK_ENDPOINT=https://api.ppio.com/v3/async/task-result
PPIO_CHAT_ENDPOINT=https://api.ppio.com/openai/v1/chat/completions
PPIO_CHAT_MODEL=deepseek/deepseek-v4-flash
# Qwen-Image Edit 要求传入 image；未上传参考图时可用此变量指定默认参考图 URL 或 data URL。
PPIO_DEFAULT_REFERENCE_IMAGE=
